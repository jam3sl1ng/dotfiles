
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/arch.txt",
    "color": {
      "1": "#a9b665",
      "2": "#a9b665"
    },
    "padding": {
      "right": 5
    }
  },

  "display": {
    "separator": " ",
    "color": {
      "keys": "#a9b665",
      "title": "#fb4934",
      "output": "#ebdbb2"
    },
    "key": {
      "width": 12
    }
  },

  "modules": [
    {
      "type": "break",
    },
    {
      "type": "title",
      "format": " {user-name}",
      "keyColor": "#fb4934",
      "outputColor": "#ebdbb2"
    },
    {
      "type": "os",
      "key": "󰣇 distro",
      "keyColor": "#83a598"
    },
    {
      "type": "kernel",
      "key": " kernel",
      "keyColor": "#b8bb26"
    },
    {
      "type": "terminal",
      "key": " term",
      "keyColor": "#fb4934"
    },
    {
      "type": "wm",
      "key": " wm",
      "keyColor": "#d3869b"
    },
    {
      "type": "disk",
      "key": "󰋊 disk",
      "keyColor": "#fabd2f"
    },
    {
      "type": "colors",
      "key": "󰏘 colors",
      "keyColor": "#a9b665",
      "symbol": "diamond"
    }
  ]
}

